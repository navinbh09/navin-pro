---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import data from '../../content/research-solar-cells.json';
import { img } from '../../lib/images';
const { seo, header, sections, presentation, thanks } = data;
---
<Base title={seo.title} description={seo.description}>
  <header class="section-tight">
    <div class="container head">
      <div>
        <a class="back" href="/">← Home</a>
        <span class="eyebrow">{header.eyebrow}</span>
        <h1 class="t">{header.title}</h1>
        <ul class="meta">{header.meta.map((m) => <li>{m}</li>)}</ul>
        <p class="lede">{header.summary}</p>
      </div>
      <figure class="hero-img">
        <Picture src={img(header.image)} alt={header.imageAlt} widths={[420, 700, 1000]} sizes="(min-width: 900px) 440px, 92vw" formats={['avif', 'webp']} loading="eager" />
      </figure>
    </div>
  </header>

  {sections.map((s) => (
    <section class="section-tight">
      <div class="container">
        <div class="narrow-left reveal">
          <h2>{s.title}</h2>
          {s.stats && (
            <div class="stats">{s.stats.map((x) => <div class="stat"><b>{x.value}</b><span>{x.label}</span></div>)}</div>
          )}
          {s.body.map((p) => <p class="lede">{p}</p>)}
          {s.quote && <p class="quote q">“{s.quote}”</p>}
        </div>
        {s.images && (
          <div class="gallery">
            {s.images.map((g) => (
              <figure class="reveal"><Picture src={img(g.file)} alt={g.alt} widths={[360, 640]} sizes="(min-width: 900px) 360px, 92vw" formats={['avif', 'webp']} /></figure>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  <section class="section-tight band">
    <div class="container reveal">
      <p class="eyebrow">{presentation.what} · {presentation.when}</p>
      <h2 class="p-where">{presentation.where}</h2>
      <p class="lede">{presentation.title}</p>
      <p class="muted">{thanks}</p>
      <p><a class="btn" href="/research/cold-plate/">Next: my cold-plate research →</a></p>
    </div>
  </section>
</Base>

<style>
  .back { display: table; margin-bottom: 22px; font-weight: 600; text-decoration: none; }
  .head { display: grid; gap: clamp(28px, 5vw, 64px); grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); align-items: center; }
  @media (max-width: 860px) { .head { grid-template-columns: 1fr; } }
  .t { font-size: clamp(2.2rem, 5vw, 3.8rem); }
  .meta { list-style: none; padding: 0; margin: 0 0 18px; display: flex; flex-wrap: wrap; gap: 6px 18px; color: var(--muted); }
  .hero-img { margin: 0; }
  .hero-img :global(img) { border-radius: 28px; aspect-ratio: 4 / 5; object-fit: cover; width: 100%; box-shadow: var(--shadow); }
  .narrow-left { max-width: 760px; }
  .stats { display: flex; flex-wrap: wrap; gap: 20px 40px; margin: 8px 0 28px; }
  .stats .stat { max-width: 220px; }
  .q { margin-top: 28px; font-size: clamp(1.4rem, 3vw, 2rem); }
  .gallery { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); margin-top: 36px; }
  .gallery figure { margin: 0; }
  .gallery :global(img) { border-radius: 18px; aspect-ratio: 3 / 4; object-fit: cover; width: 100%; }
  .p-where { font-size: clamp(1.6rem, 3.4vw, 2.4rem); }
</style>
